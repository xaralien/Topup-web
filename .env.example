# Salin ke .env (jangan di-commit). Dibaca oleh index.php.
CI_ENV=development

DB_HOST=127.0.0.1
DB_USER=root
DB_PASS=
DB_NAME=mytopup

# OPSIONAL – lebih mudah diisi di Admin > Pengaturan (database diprioritaskan; ini hanya cadangan)
DUITKU_MERCHANT_CODE=
DUITKU_API_KEY=
DUITKU_SANDBOX=1

# Opsional: kunci untuk membuat admin pertama dari browser bila server BUKAN localhost
SETUP_KEY=
